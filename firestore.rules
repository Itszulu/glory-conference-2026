rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /registrations/{id} {
      allow create: if request.resource.data.keys().hasOnly(['registrationId','conferenceYear','title','fullName','phone','email','gender','ageRange','cityState','church','attendanceType','days','accommodation','firstTime','heardFrom','createdAt'])
                    && request.resource.data.keys().hasAll(['registrationId','fullName','phone','email','gender','ageRange','cityState','church','attendanceType','days','accommodation','firstTime','heardFrom','createdAt'])
                    && (!('title' in request.resource.data) || request.resource.data.title in ['', 'Pastor', 'Reverend', 'Prophet', 'Bishop', 'Apostle', 'Minister', 'Evangelist'])
                    && request.resource.data.conferenceYear == 2026
                    && request.resource.data.registrationId == id
                    && id.matches('GC26-R-[A-Za-z0-9-]{4,64}')
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() >= 2
                    && request.resource.data.fullName.size() <= 120
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 10
                    && request.resource.data.phone.size() <= 30
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.church is string
                    && request.resource.data.church.size() >= 2
                    && request.resource.data.church.size() <= 150
                    && request.resource.data.gender in ['Male','Female']
                    && request.resource.data.ageRange in ['Under 18','18–24','25–34','35–44','45–54','55+']
                    && request.resource.data.cityState is string
                    && request.resource.data.cityState.size() > 0
                    && request.resource.data.cityState.size() <= 40
                    && request.resource.data.attendanceType in ['Individual','Group']
                    && request.resource.data.days is list
                    && request.resource.data.days.size() >= 1
                    && request.resource.data.days.size() <= 3
                    && request.resource.data.days.hasOnly(['Nov 12','Nov 13','Nov 14'])
                    && request.resource.data.accommodation in ['Yes','No']
                    && request.resource.data.firstTime in ['Yes','No']
                    && request.resource.data.heardFrom in ['Church','Friend / Family','WhatsApp','Instagram','Facebook','YouTube','Other']
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /checkIns/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['registrationId','fullName','day','checkedInAt','checkedInBy'])
        && request.resource.data.keys().hasAll(['registrationId','fullName','day','checkedInAt','checkedInBy'])
        && request.resource.data.registrationId is string
        && request.resource.data.registrationId.matches('GC26-R-[A-Za-z0-9-]{4,64}')
        && request.resource.data.day in ['Nov 12','Nov 13','Nov 14']
        && id == request.resource.data.registrationId + '_' + request.resource.data.day
        && exists(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId))
        && request.resource.data.checkedInBy == request.auth.uid
        && request.resource.data.checkedInAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /merchOrders/{id} {
      allow create: if request.resource.data.keys().hasAll(['orderId','customerName','phone','total','status','createdAt'])
                    && request.resource.data.orderId == id
                    && id.matches('GC26-M-[A-Za-z0-9-]{4,64}')
                    && request.resource.data.customerName is string
                    && request.resource.data.customerName.size() >= 2
                    && request.resource.data.customerName.size() <= 120
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 10
                    && request.resource.data.phone.size() <= 30
                    && request.resource.data.total is number
                    && request.resource.data.total > 0
                    && request.resource.data.status == 'Payment reported - awaiting verification'
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /siteSettings/{id} {
      allow read: if id == 'media';
      allow create, update, delete: if id == 'media' && isAdmin();
    }

    match /prayerDesigns/{day} {
      // Public artwork metadata is visible only after the corresponding day opens.
      // Only admins may upload/replace records; never expose a Storage token URL.
      allow get: if isAdmin() || (
        day.matches('0[1-9]|1[0-9]|2[01]') &&
        request.time >= timestamp.date(2026, 10, 22) - duration.value(1, 'h') +
          duration.value(int(day) - 1, 'd')
      );
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
