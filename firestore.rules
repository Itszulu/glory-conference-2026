rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function staffRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role','')
        : '';
    }
    function isAdmin() { return staffRole() == 'admin'; }
    function isCheckInStaff() { return staffRole() in ['admin','checkin','registration']; }
    function isRegistrationStaff() { return staffRole() in ['admin','registration']; }
    function isFollowUpStaff() { return staffRole() in ['admin','followup']; }

    // Existing administrator accounts remain protected. Admins may provision
    // operational roles only; nobody can create or upgrade to admin in-browser.
    function operationalRole(role) {
      return role in ['checkin','registration','followup'];
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid','name','email','role','createdBy','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['uid','name','email','role','createdBy','createdAt','updatedAt'])
        && request.resource.data.uid == uid
        && uid.matches('[A-Za-z0-9]{10,128}')
        && operationalRole(request.resource.data.role)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && resource.data.role != 'admin'
        && operationalRole(request.resource.data.role)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin()
        && resource.data.role != 'admin'
        && request.auth.uid != uid;
    }

    match /registrations/{id} {
      allow create: if (isRegistrationStaff() || !signedIn()) && request.resource.data.keys().hasOnly(['registrationId','conferenceYear','title','fullName','phone','email','gender','ageRange','cityState','church','attendanceType','days','accommodation','firstTime','heardFrom','attendanceFrequency','affiliation','followUpConsent','consentRecordedAt','createdAt'])
                    && request.resource.data.keys().hasAll(['registrationId','fullName','phone','email','gender','ageRange','cityState','church','attendanceType','days','accommodation','firstTime','heardFrom','createdAt'])
                    && (!('title' in request.resource.data) || request.resource.data.title in ['', 'Pastor', 'Reverend', 'Prophet', 'Bishop', 'Apostle', 'Minister', 'Evangelist'])
                    && request.resource.data.conferenceYear == 2026
                    && request.resource.data.registrationId == id
                    && id.matches('GC26-R-[A-Za-z0-9-]{4,64}')
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() >= 2
                    && request.resource.data.fullName.size() <= 120
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 10
                    && request.resource.data.phone.size() <= 30
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.church is string
                    && request.resource.data.church.size() >= 0
                    && request.resource.data.church.size() <= 150
                    && request.resource.data.gender in ['','Male','Female']
                    && request.resource.data.ageRange in ['','Under 18','18–24','25–34','35–44','45–54','55+']
                    && request.resource.data.cityState is string
                    && request.resource.data.cityState.size() > 0
                    && request.resource.data.cityState.size() <= 40
                    && request.resource.data.attendanceType in ['Individual','Group']
                    && request.resource.data.days is list
                    && request.resource.data.days.size() >= 1
                    && request.resource.data.days.size() <= 3
                    && request.resource.data.days.hasOnly(['Nov 12','Nov 13','Nov 14'])
                    && request.resource.data.accommodation in ['Yes','No']
                    && request.resource.data.firstTime in ['Yes','No']
                    && request.resource.data.heardFrom in ['Church','Friend / Family','WhatsApp','Instagram','Facebook','YouTube','Other']
                    && (!('attendanceFrequency' in request.resource.data) ||
                        request.resource.data.attendanceFrequency in ['First time','Second time','Third time or more'])
                    && (!('affiliation' in request.resource.data) ||
                        request.resource.data.affiliation in ['Host ministry','DISRM','Visiting from another church','Not currently part of a church','Prefer not to say'])
                    && (!('followUpConsent' in request.resource.data) ||
                        request.resource.data.followUpConsent is bool)
                    && (!('consentRecordedAt' in request.resource.data) ||
                        request.resource.data.consentRecordedAt == request.time)
                    && (!('attendanceFrequency' in request.resource.data) ||
                        (request.resource.data.firstTime == 'Yes' && request.resource.data.attendanceFrequency == 'First time') ||
                        (request.resource.data.firstTime == 'No' && request.resource.data.attendanceFrequency in ['Second time','Third time or more']))
                    && request.resource.data.createdAt == request.time;
      allow read: if isCheckInStaff() || isFollowUpStaff();
      // Admin profile edits include an audit timestamp; a repeat setDoc without
      // updatedAt must never silently replace an existing registration.
      allow update: if isAdmin()
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Staff follow-up notes are private: never publicly query or write them.
    match /followUps/{registrationId} {
      allow read: if isFollowUpStaff();
      allow create, update: if isFollowUpStaff()
        && exists(/databases/$(database)/documents/registrations/$(registrationId))
        && request.resource.data.keys().hasOnly(['registrationId','status','owner','notes','nextAction','lastContactOutcome','updatedBy','updatedAt'])
        && request.resource.data.registrationId == registrationId
        && request.resource.data.status in ['Unassigned','Awaiting contact','Contacted','Completed','Do not contact']
        && request.resource.data.owner is string
        && request.resource.data.owner.size() <= 120
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.nextAction is string
        && request.resource.data.nextAction.size() <= 240
        && request.resource.data.lastContactOutcome is string
        && request.resource.data.lastContactOutcome.size() <= 240
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /checkIns/{id} {
      allow read: if isCheckInStaff() || isFollowUpStaff();
      allow create: if isCheckInStaff()
        && request.resource.data.keys().hasOnly(['registrationId','fullName','day','checkedInAt','checkedInBy'])
        && request.resource.data.keys().hasAll(['registrationId','fullName','day','checkedInAt','checkedInBy'])
        && request.resource.data.registrationId is string
        && request.resource.data.registrationId.matches('GC26-R-[A-Za-z0-9-]{4,64}')
        && request.resource.data.day in ['Nov 12','Nov 13','Nov 14']
        && id == request.resource.data.registrationId + '_' + request.resource.data.day
        && exists(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId))
        && request.resource.data.checkedInBy == request.auth.uid
        && request.resource.data.checkedInAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /merchOrders/{id} {
      allow create: if request.resource.data.keys().hasAll(['orderId','customerName','phone','total','status','createdAt'])
                    && request.resource.data.orderId == id
                    && id.matches('GC26-M-[A-Za-z0-9-]{4,64}')
                    && request.resource.data.customerName is string
                    && request.resource.data.customerName.size() >= 2
                    && request.resource.data.customerName.size() <= 120
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 10
                    && request.resource.data.phone.size() <= 30
                    && request.resource.data.total is number
                    && request.resource.data.total > 0
                    && request.resource.data.status == 'Payment reported - awaiting verification'
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /siteSettings/{id} {
      allow read: if id == 'media';
      allow create, update, delete: if id == 'media' && isAdmin();
    }

    match /prayerDesigns/{day} {
      // Public artwork metadata is visible only after the corresponding day opens.
      // Only admins may upload/replace records; never expose a Storage token URL.
      allow get: if isAdmin() || (
        day.matches('0[1-9]|1[0-9]|2[01]') &&
        request.time >= timestamp.date(2026, 10, 22) - duration.value(1, 'h') +
          duration.value(int(day) - 1, 'd')
      );
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
