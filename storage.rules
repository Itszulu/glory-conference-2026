rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }
    // Original 4:5 prayer artworks stay private until their Nigerian release day.
    function prayerDayReleased(day) {
      return       (day == '01' && request.time >= (timestamp.date(2026, 10, 22) - duration.value(1, 'h'))) ||
              (day == '02' && request.time >= (timestamp.date(2026, 10, 23) - duration.value(1, 'h'))) ||
              (day == '03' && request.time >= (timestamp.date(2026, 10, 24) - duration.value(1, 'h'))) ||
              (day == '04' && request.time >= (timestamp.date(2026, 10, 25) - duration.value(1, 'h'))) ||
              (day == '05' && request.time >= (timestamp.date(2026, 10, 26) - duration.value(1, 'h'))) ||
              (day == '06' && request.time >= (timestamp.date(2026, 10, 27) - duration.value(1, 'h'))) ||
              (day == '07' && request.time >= (timestamp.date(2026, 10, 28) - duration.value(1, 'h'))) ||
              (day == '08' && request.time >= (timestamp.date(2026, 10, 29) - duration.value(1, 'h'))) ||
              (day == '09' && request.time >= (timestamp.date(2026, 10, 30) - duration.value(1, 'h'))) ||
              (day == '10' && request.time >= (timestamp.date(2026, 10, 31) - duration.value(1, 'h'))) ||
              (day == '11' && request.time >= (timestamp.date(2026, 11, 1) - duration.value(1, 'h'))) ||
              (day == '12' && request.time >= (timestamp.date(2026, 11, 2) - duration.value(1, 'h'))) ||
              (day == '13' && request.time >= (timestamp.date(2026, 11, 3) - duration.value(1, 'h'))) ||
              (day == '14' && request.time >= (timestamp.date(2026, 11, 4) - duration.value(1, 'h'))) ||
              (day == '15' && request.time >= (timestamp.date(2026, 11, 5) - duration.value(1, 'h'))) ||
              (day == '16' && request.time >= (timestamp.date(2026, 11, 6) - duration.value(1, 'h'))) ||
              (day == '17' && request.time >= (timestamp.date(2026, 11, 7) - duration.value(1, 'h'))) ||
              (day == '18' && request.time >= (timestamp.date(2026, 11, 8) - duration.value(1, 'h'))) ||
              (day == '19' && request.time >= (timestamp.date(2026, 11, 9) - duration.value(1, 'h'))) ||
              (day == '20' && request.time >= (timestamp.date(2026, 11, 10) - duration.value(1, 'h'))) ||
              (day == '21' && request.time >= (timestamp.date(2026, 11, 11) - duration.value(1, 'h')));
    }
    match /prayer-designs/{day}/{fileName} {
      allow read: if prayerDayReleased(day);
      allow write: if isAdmin()
        && fileName == 'share-artwork'
        && request.resource != null
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp');
      allow delete: if isAdmin();
    }
    match /site-media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource != null
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/mp4|video/webm');
    }
  }
}
